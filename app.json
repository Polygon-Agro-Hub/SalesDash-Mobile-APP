{
  "expo": {
    "name": "SalesDash",
    "slug": "SalesDash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/public/favicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/public/dashicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6638CE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polygonagro.SalesDash",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera access is required to scan documents and capture images.",
        "NSMicrophoneUsageDescription": "Microphone access is required for in-app communication.",
        "NSPhotoLibraryUsageDescription": "Photo library access is required to upload sales-related images.",
        "NSLocationWhenInUseUsageDescription": "Location access is required to track sales activity.",
        "NSUserTrackingUsageDescription": "Tracking is used to improve app experience.",
        "NSUserNotificationUsageDescription": "Notifications are used to send important updates.",
        "NSPhoneUsageDescription": "Phone access is used to call customers directly."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/public/favicon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.polygonagro.SalesDash",
      "versionCode": 10,
      "permissions": [
        "INTERNET",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "SYSTEM_ALERT_WINDOW",
        "NOTIFICATIONS",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/public/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "ndkVersion": "28.0.12433566",
            "enableProguardInReleaseBuilds": true,
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            },
            "gradleProperties": {
              "android.useAndroidX": "true",
              "android.enableJetifier": "true",
              "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "true"
            },
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bbee3381-e23a-4e97-a02b-ff2b3844436e"
      }
    }
  }
}
